# Copy to .env.local (gitignored). Expo public keys are safe to ship in the app binary.
#
# RevenueCat (IAP) — blocked until RC apps exist in dashboard:
#   cp backend/.env.revenuecat.example backend/.env.revenuecat
#   # fill from RevenueCat, then: bash scripts/secrets/set-revenuecat.sh
# That script pushes Worker secrets (all 4 Workers × staging+production), stores
# public keys in Keychain (symply.revenuecat.ios_public / android_public), and
# prints EAS setup steps. See documents/ecosystem/PROVISIONING.md §9.

EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# PostHog product analytics — publishable project key (safe to embed).
# Get it from PostHog → Project settings → Project API key. Empty = analytics disabled.
# See documents/engineering/analytics.md
EXPO_PUBLIC_POSTHOG_API_KEY=
# Optional — defaults to https://us.i.posthog.com (use eu.i.posthog.com for EU / self-host URL)
EXPO_PUBLIC_POSTHOG_HOST=
# Optional — set to 1 to send analytics from dev builds (verifying wiring); events are
# tagged environment=development so you can filter them out. Leave unset for prod-only data.
EXPO_PUBLIC_POSTHOG_DEV=

# Google Places — address autocomplete on the Create Home / Add Your Address
# screen. Publishable (it ships in the binary); restrict it by bundle id in the
# Google Cloud console. Empty = the street field falls back to a plain text
# input and no suggestions appear — silently, so check this first if the
# autocomplete "does nothing".
#   Keychain: symply.google.places_key
#   Fill this file from it:  ./scripts/secrets/write-env-local.sh
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# Sentry crash / error monitoring — publishable DSN (safe to embed).
# Per-brand DSNs live in brands/<id>/brand.cjs (integrations.sentry); this env var
# is the shared fallback used by brands without their own project. Empty = uses the
# built-in shared DSN. See documents/engineering/sentry.md
EXPO_PUBLIC_SENTRY_DSN=
# Optional — set to 1 to send crash reports from dev builds (verifying wiring);
# tagged environment=development. Leave unset for prod-only data.
EXPO_PUBLIC_SENTRY_DEV=
# Source-map / debug-symbol upload token (org:ci scope). Set in .env.local only —
# never commit. Keychain: symply.sentry.auth_token (see scripts/secrets).
SENTRY_AUTH_TOKEN=

# Server secrets: use scripts/secrets/set-revenuecat.sh (not manual wrangler).
