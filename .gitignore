# OSX
#
.DS_Store

# Xcode
#
build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata
*.xccheckout
*.moved-aside
DerivedData
*.hmap
*.ipa
*.xcuserstate
**/.xcode.env.local
# Active-brand override for the native tree (Brand.xcconfig ships House defaults).
ios/Brand.generated.xcconfig
# Active-brand expo-updates project URL + channel — rewritten per brand by
# write-brand-expo-plist.cjs; ships House's values until prepare-xcode.sh runs.

# Android/IntelliJ
#
build/
.idea
.gradle
local.properties
*.iml
*.hprof
.cxx/
*.keystore
!debug.keystore
.kotlin/

# node.js
#
node_modules/
npm-debug.log
yarn-error.log

# fastlane
#
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the
# screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/

**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Expo local build logs (generated by `expo run:ios`)
.expo/
.expo/xcodebuild.log
.expo/xcodebuild-error.log

# Bundle artifact
*.jsbundle

# `eas update` / `expo export` output. Regenerated on every publish and huge —
# ~165 MB, most of it .hbc source maps. It was tracked by accident until Sep
# 2026, when 471 stale files of it rode out on an unrelated `git commit -a`;
# without this line the next publish followed by the next `commit -a` puts them
# straight back.
/dist/

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# testing
/coverage

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Wrangler local state
backend/.wrangler/

# Wrangler local dev secrets — never commit
backend/.dev.vars
backend/.dev.vars.*
!backend/.dev.vars.example

# Lambda processor packages (dependencies)
backend/lambda-processor/package/

# Lambda zip files (large, can be rebuilt)
backend/lambda-processor/*.zip

# Lambda processor temp and virtual env
backend/lambda-processor/lambda-package-temp/
backend/lambda-processor/venv/

# Pip install artifacts
backend/lambda-processor/=*

# EAS local credentials — distribution certificate private key + provisioning profiles, never commit
/credentials.json
/credentials/

# Maestro E2E login (local only)
e2e/credentials.local
.env.e2e.local

# Generated Maestro HTML reports (screenshots + backend calls) — regenerable, large, and
# tied to whatever account data was on screen when captured; never commit these.
e2e/reports/

# Sentry source-map upload credentials
.env.local
.env.sentry-build-plugin

*.swp

# Generated House→Budget migration dumps
backend/migrate-house-to-budget-*.sql
.xcode-brand.active

# Worker / RevenueCat local secret files (filled from vault; never commit)
backend/.env.revenuecat
backend/.env.*-secrets

# Local scratch / E2E logs (never commit)
.tmp/

# E2E Maestro run reports: HTML is tracked (history of what ran/passed/failed
# over time); screenshots are local-only (60-600MB per full-suite run — not
# worth the permanent git bloat, see the *-suite-live-report.sh scripts).
documents/engineering/testing/reports/**/assets/
# .run-dirs holds per-flow symlinks into ~/.maestro/tests, consumed while the
# report is generated. They dangle once Maestro's own output is cleaned up.
documents/engineering/testing/reports/**/.run-dirs/
