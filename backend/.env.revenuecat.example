# RevenueCat — fill from https://app.revenuecat.com/ then run:
#   cp backend/.env.revenuecat.example backend/.env.revenuecat
#   bash scripts/secrets/set-revenuecat.sh
#
# Five App Store Connect apps exist; create five matching RevenueCat apps
# (one per bundle ID — see documents/ecosystem/PROVISIONING.md §9).
# Re-run this file per brand if public SDK keys differ; Worker server secrets
# are usually shared per RC project and are pushed to all 4 Workers automatically.
#
# --- Worker secrets (server-side; never commit filled file) ---
# Project → API keys → Secret API key
REVENUECAT_SECRET_API_KEY=
# Integrations → Webhooks → Authorization header value (you choose this string)
REVENUECAT_WEBHOOK_AUTH=
# Optional — Project settings → Project ID (validates app_id on webhook/sync)
REVENUECAT_PROJECT_ID=
#
# --- Mobile public SDK keys (safe to embed; one pair per RC app / bundle ID) ---
# Project → Apps → [your app] → API keys → Apple / Google public keys
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
