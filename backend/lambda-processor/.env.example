# Lambda Deployment Configuration
# Copy this file to .env and fill in your values

# Environment (dev, staging, production)
DEPLOY_ENV=dev

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=907308712679

# Function Names (customize per environment)
FUNCTION_NAME_DEV=inspection-report-processor-dev
FUNCTION_NAME_STAGING=inspection-report-processor-staging
FUNCTION_NAME_PROD=inspection-report-processor

# Layer Names
LAYER_NAME_DEV=inspection-report-dependencies-dev
LAYER_NAME_STAGING=inspection-report-dependencies-staging
LAYER_NAME_PROD=inspection-report-dependencies

# R2/Storage Configuration (optional for testing)
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=simple-house-reports
