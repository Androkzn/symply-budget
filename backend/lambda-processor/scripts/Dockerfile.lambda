# Use official AWS Lambda Python runtime image
FROM public.ecr.aws/lambda/python:3.11

# Install system dependencies for Pillow and PyMuPDF
RUN yum install -y \
    gcc \
    gcc-c++ \
    freetype-devel \
    libjpeg-turbo-devel \
    zlib-devel \
    && yum clean all

# Copy requirements
COPY requirements.txt .

# Install Python dependencies to /asset
RUN pip install --no-cache-dir -r requirements.txt -t /asset

# Copy Lambda function code
COPY handler.py job_state.py structured_logger.py batch_processor.py /asset/

# Set working directory
WORKDIR /asset
