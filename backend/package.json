{
  "name": "symply-budget-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "test": "vitest run",
    "smoke:assistant-room": "node scripts/assistant-room-live-smoke.mjs",
    "test:data-bridge": "vitest run __tests__/data-bridge",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "db:generate": "drizzle-kit generate",
    "db:generate:guard": "node scripts/db-generate-guard.mjs",
    "guard:all-tables": "node scripts/all-tables-guard.mjs",
    "check:migrations:frozen": "bash scripts/check-frozen-migration.sh",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:remote:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:remote:production": "wrangler d1 migrations apply DB --remote --env production",
    "db:migrate:list:staging": "wrangler d1 migrations list DB --remote --env staging",
    "db:migrate:list:production": "wrangler d1 migrations list DB --remote --env production",
    "deploy:all": "npm run deploy:staging && npm run deploy:production",
    "ops:dlq-retention": "bash scripts/set-dlq-retention.sh",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/generative-ai": "^0.21.0",
    "@hono/zod-validator": "^0.4.1",
    "@sentry/cloudflare": "^9.47.1",
    "@symply/contracts": "file:../packages/contracts",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.7",
    "jose": "^5.9.6",
    "jpeg-js": "^0.4.4",
    "upng-js": "^2.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.20",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^22.10.1",
    "@types/upng-js": "^2.1.5",
    "@vitest/coverage-v8": "^4.1.9",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.16.0",
    "miniflare": "^3.20241106.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.105.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
