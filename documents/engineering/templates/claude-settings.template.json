{
  "_README": "Portable Claude Code permission template. Copy to <new-repo>/.claude/settings.json, replace every <PLACEHOLDER> with an ABSOLUTE path (~ is not expanded in permission rules), and trim the allow list to the toolchain this project actually uses. Docs: documents/engineering/agent-permissions.md",

  "_DENY_IS_OPTIONAL": "Symply Ecosystem itself runs WITHOUT a deny list — guardrails there are the prose rules in CLAUDE.md section 1. The deny block below is opt-in hardening: it never prompts, it refuses outright, and it overrides bypassPermissions. Delete it to match Symply Ecosystem exactly.",

  "permissions": {
    "defaultMode": "bypassPermissions",

    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --delete:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout --:*)",
      "Bash(git filter-branch:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf <REPO_ROOT>:*)",
      "Read(//<REPO_ROOT>/**/.env.local)",
      "Read(//<REPO_ROOT>/**/credentials/**)"
    ],

    "allow": [
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "Bash(cut:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(tr:*)",
      "Bash(jq:*)",
      "Bash(diff:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(tree:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(date:*)",
      "Bash(which:*)",
      "Bash(cd:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(rm:*)",
      "Bash(tee:*)",
      "Bash(ps:*)",
      "Bash(pkill:*)",
      "Bash(kill:*)",
      "Bash(curl:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(bun:*)",
      "Bash(tsc:*)",
      "Bash(tsx:*)",

      "Read(//<REPO_ROOT>/**)",
      "Edit(//<REPO_ROOT>/**)",
      "Write(//<REPO_ROOT>/**)",
      "Read(//<READONLY_SIBLING>/**)"
    ],

    "additionalDirectories": [
      "/tmp"
    ]
  }
}
