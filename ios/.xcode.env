# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned.

# NODE_BINARY for Xcode Run Script phases (Bundle React Native, Expo configure).
# Xcode GUI uses a minimal PATH and often picks /usr/local/bin/node (v18).
# Expo/metro require Node >= 20.19.4 (`Array.prototype.toReversed`).
export NODE_BINARY=""
for _n in \
  /opt/homebrew/opt/node@22/bin/node \
  /opt/homebrew/bin/node \
  /usr/local/opt/node@22/bin/node \
  "$(command -v node 2>/dev/null)"; do
  if [ -n "$_n" ] && [ -x "$_n" ]; then
    _maj="$("$_n" -p "parseInt(process.versions.node, 10)" 2>/dev/null || echo 0)"
    if [ "$_maj" -ge 20 ]; then
      export NODE_BINARY="$_n"
      break
    fi
  fi
done
unset _n _maj
if [ -z "$NODE_BINARY" ]; then
  export NODE_BINARY=$(command -v node)
fi

# App uses expo-router + @react-navigation native stacks (fleet navigators).
export EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1
# Local Archive must not fail on missing Sentry upload credentials.
export SENTRY_ALLOW_FAILURE=true
export SENTRY_DISABLE_AUTO_UPLOAD=true
