{
  "name": "symply-budget",
  "version": "0.0.1",
  "main": "index.ts",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "android": "EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 npx @expo/cli run:android",
    "ios": "EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 npx @expo/cli run:ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "start": "./scripts/start-brand.sh symply-budget",
    "start:budget": "./scripts/start-brand.sh symply-budget",
    "prepare:xcode:budget": "./scripts/prepare-xcode.sh symply-budget",
    "verify:standalone": "./scripts/verify-standalone.sh",
    "verify:apps": "./scripts/verify-apps-ready.sh",
    "eas-build-pre-install": "./scripts/eas-build-pre-install.sh",
    "eas-build-post-install": "./scripts/eas-build-post-install.sh",
    "validate:brand": "node scripts/validate-brand.cjs",
    "tokens:build": "node scripts/build-tokens.mjs",
    "icons:build": "node scripts/build-brand-icons.mjs",
    "logos:lenders": "node scripts/normalize-lender-logos.mjs",
    "icons:gen": "node scripts/generate-icons.mjs",
    "icons:generate": "node scripts/generate-brand-icon-pngs.mjs",
    "icons:import-brush-sheets": "node scripts/import-budget-brush-sheets.mjs",
    "icons:audit": "node scripts/audit-brand-icon-centering.mjs",
    "design:build": "npm run tokens:build && npm run icons:build && npm run sync:widget-theme && npm run sync:watch-icons",
    "sync:widget-theme": "node scripts/sync-widget-theme.cjs",
    "sync:watch-icons": "node scripts/ios/sync-watch-app-icons.cjs",
    "test": "jest",
    "test:scroll": "npm test -- --testPathPattern='scrollContract|scrollableScreens|KaizenScreen.test|TodayScreen.test'",
    "test:e2e:scroll": "bash scripts/run-e2e-scroll.sh",
    "test:e2e:scroll:budget": "E2E_SCROLL_BRAND=budget bash scripts/run-e2e-scroll.sh",
    "test:e2e:budget:suite": "bash scripts/e2e/run-budget-suite.sh",
    "test:e2e:all:suites": "bash scripts/e2e/run-all-suites.sh",
    "test:e2e:feature": "bash scripts/e2e/run-feature.sh",
    "test:e2e:tags": "node scripts/e2e/apply-maestro-tags.mjs",
    "test:data-bridge": "npm test -- --testPathPattern='data-bridge|secure-token-storage|platform-spine|joined-platform-auth|authStore.data-bridge|LoginScreen.data-bridge|RegisterScreen.data-bridge|widget-sync|health-migrate-gate|resolveFailClosed'",
    "test:e2e": "bash scripts/run-e2e.sh",
    "test:e2e:auth": "bash scripts/run-e2e.sh e2e/maestro/auth",
    "test:e2e:biometric": "E2E_DEVICE=Kaizen-A bash scripts/run-e2e-biometric.sh",
    "test:e2e:home": "bash scripts/run-e2e.sh e2e/maestro/home",
    "test:e2e:mira": "bash scripts/run-e2e.sh e2e/maestro/mira",
    "test:e2e:chat": "bash scripts/run-e2e.sh e2e/maestro/chat",
    "test:e2e:settings": "bash scripts/run-e2e.sh e2e/maestro/settings",
    "test:e2e:tasks": "bash scripts/run-e2e.sh e2e/maestro/tasks",
    "test:e2e:budget": "bash scripts/run-e2e.sh e2e/maestro/budget",
    "test:e2e:tasks-budget": "bash scripts/run-e2e-flows.sh",
    "test:e2e:reports": "bash scripts/run-e2e.sh e2e/maestro/reports",
    "test:e2e:contractors": "bash scripts/run-e2e.sh e2e/maestro/contractors",
    "test:e2e:gardening": "bash scripts/run-e2e.sh e2e/maestro/gardening",
    "test:e2e:notifications": "bash scripts/run-e2e.sh e2e/maestro/notifications",
    "test:e2e:profile": "bash scripts/run-e2e.sh e2e/maestro/profile",
    "test:e2e:my-home": "bash scripts/run-e2e.sh e2e/maestro/my-home",
    "test:e2e:neighbours": "bash scripts/run-e2e.sh e2e/maestro/neighbours",
    "test:e2e:utilities": "bash scripts/run-e2e.sh e2e/maestro/utilities",
    "test:contracts": "npm run test -w @symply/contracts",
    "test:local-first": "npm run test -w @symply/local-first",
    "test:budget:local": "jest --testPathPattern='src/features/budget/local' --no-coverage",
    "postinstall": "npx patch-package",
    "sim:report": "bash scripts/e2e/sim-disk-guard.sh --report",
    "sim:gc": "bash scripts/e2e/disk-gc.sh --sims",
    "disk:report": "bash scripts/e2e/disk-gc.sh",
    "disk:gc": "bash scripts/e2e/disk-gc.sh --all"
  },
