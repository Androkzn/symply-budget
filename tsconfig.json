{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "types": ["jest"],
    "baseUrl": ".",
    "paths": {
      "@symply/contracts": ["packages/contracts/src/index.ts"],
      "@symply/contracts/*": ["packages/contracts/src/*"],
      "@symply/local-first": ["packages/local-first/src/index.ts"],
      "@symply/local-first/*": ["packages/local-first/src/*"],
      "@/*": ["src/*"],
      "@api": ["src/api"],
      "@api/*": ["src/api/*"],
      "@assets/*": ["src/assets/*"],
      "@brand": ["src/brand"],
      "@brand/*": ["src/brand/*"],
      "@components/*": ["src/components/*"],
      "@config/*": ["src/config/*"],
      "@constants/*": ["src/constants/*"],
      "@contexts/*": ["src/contexts/*"],
      "@features/*": ["src/features/*"],
      "@hooks/*": ["src/hooks/*"],
      "@navigation/*": ["src/navigation/*"],
      "@screens/*": ["src/screens/*"],
      "@services/*": ["src/services/*"],
      "@stores/*": ["src/stores/*"],
      "@theme": ["src/theme"],
      "@theme/*": ["src/theme/*"],
      "@models/*": ["src/types/*"],
      "@types/*": ["src/types/*"],
      "@utils/*": ["src/utils/*"],
      "@shared-user": ["src/shared-user"],
      "@shared-user/*": ["src/shared-user/*"],
      "@smart-engine": ["src/smart-engine"],
      "@smart-engine/*": ["src/smart-engine/*"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "brands/**/*.ts",
    "app.config.ts",
    "packages/contracts/src/**/*.ts",
    "packages/local-first/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/node_modules/**",
    "**/Pods/**",
    "**/android/**",
    "**/ios/**",
    "backend/**",
    "symply-house/**",
    "brands/*/src/assets/icons/**",
    "**/node_modules/**/*.ts",
    "**/node_modules/**/*.tsx",
    "**/node_modules/**/*.json"
  ]
}
